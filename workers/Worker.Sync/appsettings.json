{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Ansi"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Sync": {
    "IntervalMinutes": 120,
    "HistorialMesesRetencion": 6,
    "ImageBaseUrl": "https://www.toku.com.py/media/",
    "ImagenPorDefecto": "https://www.toku.com.py/media/sinimagen.jpg",
    "LinkPattern": "https://www.toku.com.py/?s={code}"
  }
}
