# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=change-me-in-production
DB_NAME=comprasparaguaidb

# Oracle Connection (for Worker.Sync)
ORACLE_CONNECTION_STRING=Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=oracle-host)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=service-name)));User Id=username;Password=password;

# Compras Paraguai API
COMPRAS_API_URL=https://produtos.comprasparaguai.com.br
COMPRAS_API_TOKEN=your-compras-api-token-here

# Compara Paraguai API
COMPARA_API_URL=https://comparaparaguai.com/api/integracao/produtos
COMPARA_API_TOKEN=your-compara-api-token-here

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://172.16.249.94:4200,http://172.16.249.94
