# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=change-me-in-production
DB_NAME=comprasparaguaidb

# Oracle Connection (for Worker.Sync)
ORACLE_CONNECTION_STRING=Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=oracle-host)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=service-name)));User Id=username;Password=password;

# Compras Paraguai API
COMPRAS_API_URL=https://produtos.comprasparaguai.com.br
COMPRAS_API_TOKEN=your-compras-api-token-here

# Compara Paraguai API
COMPARA_API_URL=https://comparaparaguai.com/api/integracao/produtos
COMPARA_API_TOKEN=your-compara-api-token-here

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://172.16.249.94:4200,http://172.16.249.94

# Login del panel (la API exige sesión solo para modificar; ver datos es libre)
# Clave de firma del token: mínimo 32 caracteres, p. ej. `openssl rand -hex 32`. Si falta, la API usa una
# clave temporal y las sesiones se pierden al reiniciar.
AUTH_JWT_SECRET=change-me-with-at-least-32-characters
# Primer usuario: se crea solo si la tabla usuarios está vacía. Cambia la contraseña de ejemplo.
AUTH_ADMIN_USUARIO=admin
AUTH_ADMIN_PASSWORD=change-me

# worker-verify (comprobar disponibilidad en Compras): 0 = solo cuando alguien aprieta "Revisar ahora" en el panel;
# N = además lo pide solo cada N horas (p. ej. 6).
VERIFY_AUTO_HORAS=0

# Versión de las imágenes a levantar (por defecto latest). Útil para fijar o volver a una versión: IMAGE_TAG=1.2.0
IMAGE_TAG=latest
