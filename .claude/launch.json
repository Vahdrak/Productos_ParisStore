{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ng-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--prefix", "frontend/comprasparaguai-front"],
      "port": 4200
    },
    {
      "name": "api-dev",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/ComprasParaguai.Api/ComprasParaguai.Api.csproj"],
      "port": 5000
    },
    {
      "name": "worker-sync",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "workers/Worker.Sync/Worker.Sync.csproj"],
      "port": 5001
    }
  ]
}
