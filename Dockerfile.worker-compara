# Build stage
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS builder
WORKDIR /src

# Copy project files
COPY ["workers/Worker.Compara/Worker.Compara.csproj", "workers/Worker.Compara/"]
COPY ["backend/ComprasParaguai.Core/ComprasParaguai.Core.csproj", "backend/ComprasParaguai.Core/"]
COPY ["backend/ComprasParaguai.Infrastructure/ComprasParaguai.Infrastructure.csproj", "backend/ComprasParaguai.Infrastructure/"]

# Restore
RUN dotnet restore "workers/Worker.Compara/Worker.Compara.csproj"

# Copy everything
COPY . .

# Build
WORKDIR "/src/workers/Worker.Compara"
RUN dotnet build "Worker.Compara.csproj" -c Release -o /app/build

# Publish stage
FROM builder AS publish
RUN dotnet publish "Worker.Compara.csproj" -c Release -o /app/publish

# Runtime stage
FROM mcr.microsoft.com/dotnet/runtime:8.0
WORKDIR /app
COPY --from=publish /app/publish .

ENTRYPOINT ["dotnet", "Worker.Compara.dll"]
