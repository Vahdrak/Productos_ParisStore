{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Ansi"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Sync": {
    "IntervalMinutes": 15,
    "ImageBaseUrl": "https://tu-dominio-de-imagenes/",
    "ImagenPorDefecto": "https://tu-dominio-de-imagenes/default.png",
    "LinkPattern": "https://tu-tienda.com/producto/{code}"
  },
  "ConnectionStrings": {
    "Oracle": "(será leída desde User Secrets en dev)",
    "PostgreSQL": "(será leída desde User Secrets en dev)"
  }
}
